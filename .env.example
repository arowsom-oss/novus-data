# ---------------------------------------------------------------------------
# Novus Data — environment variables
#
# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored and must never be committed.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle. Do not
# put a secret behind that prefix.
# ---------------------------------------------------------------------------

# Site-facing -----------------------------------------------------------------

# Absolute origin of the deployed site, no trailing slash.
# Used for canonical URLs, sitemap entries and Open Graph image URLs.
# Optional: falls back to https://$VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Where "Subscribe" sends people. Required before launch.
NEXT_PUBLIC_BEEHIIV_SUBSCRIBE_URL=

# The Beehiiv publication homepage, linked from the footer. Optional.
NEXT_PUBLIC_BEEHIIV_HOME_URL=

# The Beehiiv RSS feed, linked from the footer so readers can subscribe by
# feed. Optional, and separate from BEEHIIV_RSS_URL below by design: this one
# is a public link, that one is a build tool input.
NEXT_PUBLIC_BEEHIIV_FEED_URL=

# Public contact address. Required before launch.
NEXT_PUBLIC_CONTACT_EMAIL=

# Which content source the site reads. "local" (default) reads
# content/issues/. "fixtures" is development only and refuses to build for
# production — see src/lib/content/sources/fixtures.ts.
CONTENT_SOURCE=local

# Accounts -------------------------------------------------------------------
# Leave ACCOUNT_STORE unset and the site builds and deploys exactly as before,
# with no accounts and no database. Set it to "supabase" and the three values
# below become required. See DEPLOY.md Part 4.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable "anon" key. This one is PUBLIC by design — it ships to the
# browser, and what protects the data is the row-level security policy on every
# table, not the secrecy of this string.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role key. NEVER give this a NEXT_PUBLIC_ prefix and never commit
# it: it BYPASSES EVERY ROW-LEVEL SECURITY POLICY, so a copy in the browser
# bundle makes every reader's data public. It is read on the server only, and
# used for exactly one thing — deleting a row from auth.users. The code throws
# at module load if it ever sees a NEXT_PUBLIC_ version of this key.
SUPABASE_SERVICE_ROLE_KEY=

# Which account store the site uses. There is no authentication yet, so the
# default — unset, meaning "none" — is correct, and the account layer throws a
# message saying so if anything asks it for a repository. "memory" is a
# development affordance that keeps accounts in one process, loses them on
# restart, and refuses to load in a production build. "supabase" is the real
# store and needs the three values above.
ACCOUNT_STORE=

# Live data -------------------------------------------------------------------
# /monitor and /live.json read nine public feeds. Seven need no key. This one
# enables the chokepoint vessel counts; without it that panel says "not
# switched on yet" and everything else still works. Free: sign in at
# https://aisstream.io, open "API Keys", create one. See DEPLOY.md Part 5.
#
# SERVER ONLY. Never give it a NEXT_PUBLIC_ prefix — the build refuses if it
# sees one, because the key would be published in the browser bundle.
AISSTREAM_API_KEY=

# Share prices on /monitor. OFF unless set — and read DEPLOY.md Part 6 before
# setting it on the public site: Finnhub's free plan is for personal,
# non-commercial use, and showing its prices publicly is redistribution.
# Server only; the build refuses a NEXT_PUBLIC_ version.
FINNHUB_API_KEY=

# Set to 1 to allow a production build while publication.ts still has
# unanswered inputs. Used by `npm run preview`. Leave unset on Vercel so a
# real deployment fails loudly rather than shipping an unfinished About page.
NOVUS_ALLOW_INCOMPLETE=

# Sync-only ------------------------------------------------------------------
# Read exclusively by scripts/sync-issues.ts. The website never reads this at
# build time or at runtime, and it does NOT need to be set on Vercel.

BEEHIIV_RSS_URL=
